# Mode B — Caddy bawaan + IP publik (dipasang install.sh ke /opt/balesin/Caddyfile).
#
# Caddy mengurus sertifikat Let's Encrypt otomatis untuk BALESIN_DOMAIN (DNS A record domain harus
# sudah mengarah ke IP publik server, port 80 & 443 terbuka). Semua lalu lintas diteruskan ke
# gateway Balesin (web:8080), yang memasang header keamanan dan meneruskan /api ke api.
#
# Nilai {$…} dibaca dari environment container caddy (diisi dari .env lewat docker-compose.yml).

{
	email {$ACME_EMAIL}
	# Tanpa admin API (tidak dibutuhkan; konfigurasi dimuat ulang dengan restart container).
	admin off
}

{$BALESIN_DOMAIN} {
	# Caddy adalah proxy terdepan: X-Forwarded-For dari klien TIDAK dipercaya (bawaan Caddy) dan
	# diganti alamat klien sebenarnya; X-Forwarded-Proto = https.
	reverse_proxy web:8080 {
		# Unggahan besar dialirkan langsung ke gateway (batas ukuran dijaga gateway & api).
		request_buffers 0
		flush_interval -1
		transport http {
			dial_timeout 5s
			# WebSocket inbox & unggahan lambat.
			read_timeout 1h
			write_timeout 1h
		}
	}

	header -Server

	# Log akses Caddy sengaja tidak diaktifkan: gateway sudah mencatat setiap permintaan TANPA
	# query string (URL media bertanda tangan tidak pernah masuk log).
}
