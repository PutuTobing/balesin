{
  "name": "@balesin/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup && node ../../packages/core/scripts/check-bundle-deps.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:deploy": "vitest run --config vitest.deploy.config.ts"
  },
  "dependencies": {
    "@balesin/core": "workspace:*",
    "@balesin/db": "workspace:*",
    "@balesin/shared": "workspace:*",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.9",
    "@fastify/websocket": "11.3.7",
    "@node-rs/argon2": "2.2.2",
    "@zxcvbn-ts/language-common": "3.0.4",
    "bullmq": "6.7.8",
    "drizzle-orm": "catalog:",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "htmlparser2": "12.0.0",
    "imapflow": "2.12.2",
    "ioredis": "catalog:",
    "mailparser": "3.15.0",
    "nodemailer": "10.6.1",
    "pg": "catalog:",
    "pino": "catalog:",
    "qrcode-generator": "2.0.4",
    "sanitize-html": "2.18.2",
    "sharp": "0.35.5",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "8.18.2",
    "pino-pretty": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
