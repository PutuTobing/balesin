# Salin ke .env (JANGAN commit .env)
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# Postgres & Redis (docker-compose.dev.yml)
DATABASE_URL=postgres://balesin:balesin@localhost:5432/balesin
REDIS_URL=redis://:balesin@localhost:6379

# 32 byte acak base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BALESIN_MASTER_KEY=
SESSION_SECRET=
# Token sekali pakai untuk wizard setup Owner pertama
SETUP_TOKEN=

# Email pengirim (bisa juga diisi lewat wizard)
SMTP_HOST=mail.skytech.net.id
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=balesin@skytech.net.id
SMTP_PASSWORD=
SMTP_FROM="Balesin Sky Tech <balesin@skytech.net.id>"

# Meta Graph API
META_GRAPH_VERSION=
# Kredensial WhatsApp dimasukkan lewat wizard di aplikasi (disimpan terenkripsi di DB)

# Webhook keluar ke IP privat (mis. n8n di LAN), pisahkan dengan koma
OUTBOUND_PRIVATE_ALLOWLIST=
