# Salin ke .env (JANGAN commit .env). Nilai di bawah cocok untuk pengembangan lokal
# dengan `pnpm db:up` (Postgres + Redis lewat Docker).

# ── Aplikasi ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Alamat publik web & API (dipakai untuk link di email, CORS, cookie)
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
# Alamat & port yang didengarkan API
API_HOST=127.0.0.1
API_PORT=3000
# trace | debug | info | warn | error
LOG_LEVEL=info
# Isi true hanya jika API berada di belakang reverse proxy tepercaya (nginx/Caddy/Tunnel)
TRUST_PROXY=false

# ── Postgres & Redis (deploy/docker-compose.dev.yml) ────────────────────────
DATABASE_URL=postgres://balesin:balesin@localhost:5432/balesin
# Database terpisah untuk tes integrasi
DATABASE_URL_TEST=postgres://balesin:balesin@localhost:5432/balesin_test
REDIS_URL=redis://:balesin@localhost:6379

# ── Rahasia aplikasi ────────────────────────────────────────────────────────
# Masing-masing 32 byte acak base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Master key mengenkripsi token Meta, password SMTP, dll. di database.
# JANGAN diganti setelah ada data: kredensial tersimpan tidak akan bisa dibuka lagi.
BALESIN_MASTER_KEY=
SESSION_SECRET=
# Token sekali pakai untuk wizard setup Owner pertama
SETUP_TOKEN=

# ── Email pengirim: CADANGAN OPSIONAL ───────────────────────────────────────
# Sumber utama = Pengaturan → Email pengirim di aplikasi (docs/PENGATURAN-UI.md).
# Biarkan kosong kecuali perlu email sebelum wizard setup selesai.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Contoh: "Balesin <cs@perusahaan.co.id>"
SMTP_FROM=

# ── Meta Graph API ──────────────────────────────────────────────────────────
# Versi Graph API yang dikunci (format vNN.0, lihat docs/SETUP-META.md). Diperbarui sengaja.
META_GRAPH_VERSION=
# Kredensial WhatsApp dimasukkan lewat wizard di aplikasi (disimpan terenkripsi di DB)

# ── Media ───────────────────────────────────────────────────────────────────
# Folder penyimpanan lampiran (disk lokal)
MEDIA_DIR=./media

# ── Webhook keluar ──────────────────────────────────────────────────────────
# IP/CIDR privat yang boleh dituju webhook keluar (mis. n8n di LAN), pisahkan dengan koma
OUTBOUND_PRIVATE_ALLOWLIST=
